{
  "uid": "stream-health",
  "title": "Stream health",
  "description": "Throughput and lag of the AIS stream, from Prometheus: the broker's view (Kafka exporter) and the job's view (Flink's reporter).",
  "tags": ["ais", "kafka", "flink"],
  "timezone": "utc",
  "editable": false,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 41,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Messages per second, by topic",
      "description": "Rate of the latest offset of each topic (broker view): what the producer writes.",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (topic) (rate(kafka_topic_partition_current_offset{topic=~\"ais.+\"}[$__rate_interval]))",
          "legendFormat": "{{topic}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Flink consumer lag, by partition",
      "description": "Messages of ais.positions not yet committed by the Flink job (consumer group flink-ais, broker view). Flink commits its offsets on checkpoints, every 30 seconds, so the lag rises and falls in steps; it stays measurable while the job is down.",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "kafka_consumergroup_lag{consumergroup=\"flink-ais\"}",
          "legendFormat": "partition {{partition}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Positions read by Flink per second",
      "description": "Records emitted by the Kafka source of the Flink job (job view).",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(flink_taskmanager_job_task_operator_numRecordsOutPerSecond{operator_name=~\"Source:_positions.*\"})",
          "legendFormat": "read"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(flink_taskmanager_job_task_operator_pendingRecords{operator_name=~\"Source:_positions.*\"})",
          "legendFormat": "pending in Kafka (job view)"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Watermark behind the clock",
      "description": "How far the event-time watermark of the Flink source is behind the wall clock. On live traffic it stays around the 30-second out-of-order allowance; on a replay of old traffic it starts hours behind and catches up.",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(flink_taskmanager_job_task_operator_watermarkLag{operator_name=~\"Source:_positions.*\"}) / 1000",
          "legendFormat": "watermark behind the clock"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Dead letters per second",
      "description": "Messages the producer could not parse, written verbatim to ais.dlq.",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(kafka_topic_partition_current_offset{topic=\"ais.dlq\"}[$__rate_interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Total Flink lag",
      "description": "Sum of the committed lag over the partitions of ais.positions.",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(kafka_consumergroup_lag{consumergroup=\"flink-ais\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5000 },
              { "color": "red", "value": 50000 }
            ]
          }
        },
        "overrides": []
      }
    }
  ]
}
